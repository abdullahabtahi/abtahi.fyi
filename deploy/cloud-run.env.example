# ==============================================================================
# Cloud Run Non-Secret Release Input Template
# Supply environment-specific deployment variables outside version control.
# Secrets (e.g. CSRF_SECRET) are mounted via Secret Manager, never in this file.
# ==============================================================================

# Target Google Cloud Platform Environment
GCP_PROJECT_ID=spatial-cat-489006-a4
GCP_REGION=us-central1
SERVICE_NAME=abtahi-fyi
IMAGE_NAME=us-central1-docker.pkg.dev/spatial-cat-489006-a4/cloud-run-source-deploy/abtahi-fyi:latest

# Core Application & Allowlisted Identity
ALLOWLISTED_EMAIL=learner@example.com
PORT=8080
ENV=production

# Cloud Scheduler Workload Identity (OIDC)
SCHEDULER_SERVICE_ACCOUNT=abtahi-fyi-scheduler@spatial-cat-489006-a4.iam.gserviceaccount.com
SCHEDULER_AUDIENCE=https://abtahi-fyi-903682941870.us-central1.run.app

# Feed Ingestion Configuration
INGESTION_OWNER_UID=learner-uid
APPROVED_FEED_URLS=https://eebench.org/feed.xml

# Firebase Web Client Configuration (Public metadata)
FIREBASE_PROJECT_ID=spatial-cat-489006-a4
FIREBASE_AUTH_DOMAIN=spatial-cat-489006-a4.firebaseapp.com
FIREBASE_APP_ID=1:903682941870:web:abcdef123456
FIREBASE_STORAGE_BUCKET=spatial-cat-489006-a4.firebasestorage.app
