# ==============================================================================
# abtahi.fyi — Environment Configuration Template
# Copy this file to .env and supply project-specific values.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Application Security & Learner Allowlist
# CSRF_SECRET is loaded from Secret Manager in production if omitted here
CSRF_SECRET=your-random-32-byte-hex-or-secret-token
ALLOWLISTED_EMAIL=learner@example.com
# Privileged scheduler/admin request token and private collection registry.
JOB_AUTH_TOKEN=replace-with-a-random-job-token
INGESTION_OWNER_UID=verified-learner-firebase-uid
APPROVED_FEED_URLS=https://blog.bluedot.org/feed

# Firebase Web Client Configuration (Public Client IDs)
# These values can be found in Firebase Console -> Project Settings -> General -> Your apps
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-gcp-project-id
FIREBASE_APP_ID=1:1234567890:web:abcdef123456
FIREBASE_STORAGE_BUCKET=your-gcp-project-id.firebasestorage.app

# Optional AI Configuration (Omit to use native GCP Vertex AI ADC credentials)
# GEMINI_API_KEY=
